# =============================================================================
# DLC Protect — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values. All settings have safe defaults for
# local development.

# ── Server ──
PORT=3000

# ── Mock Mode ──
# Set to "true" to test WITHOUT the real Steam API (uses fake SteamID)
MOCK_STEAM=true
# Set to "true" to skip API key validation (for local testing)
MOCK_API_KEY=true

# ── Steam API (Production) ──
# From https://steamcommunity.com/dev/apikey
# STEAM_WEB_API_KEY=your_steam_web_api_key

# ── DLC Key ──
# Fixed AES-256 key for your test DLC (base64, 32 bytes).
# Generate: node tools/generate-aes-key.mjs
DLC_AES_KEY_BASE64=

# ── Offline Tokens ──
# Secret used to sign offline JWT tokens. CHANGE IN PRODUCTION.
JWT_SECRET=dev-jwt-secret-do-not-use-in-production

# ── Rate Limiting ──
# Set to "true" to disable (not recommended in production)
# DISABLE_RATE_LIMIT=false

# ── Supabase (Production) ──
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key