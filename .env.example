# =============================================================================
# Steam DLC Protection SDK — Root Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# The local test server has its own .env at local-test-server/.env.example

# ── Steam API ───────────────────────────────────────────────────────────────
# Your Steam Publisher Web API Key (from https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=your_steam_web_api_key_here

# ── Mock Mode ────────────────────────────────────────────────────────────────
# Set to "true" to test WITHOUT hitting the real Steam API
MOCK_STEAM=true

# ── DLC Encryption Key ──────────────────────────────────────────────────────
# Optional: Fixed AES-256 key for the test DLC (base64, 32 bytes).
# If empty, a random key is generated per request (for testing only).
# Generate one: node tools/generate-aes-key.mjs
# DLC_AES_KEY_BASE64=

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Set to "true" to disable rate limiting (useful for CI / test suites)
# DISABLE_RATE_LIMIT=false

# ── Supabase (Production) ───────────────────────────────────────────────────
# Your Supabase project URL and service role key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key