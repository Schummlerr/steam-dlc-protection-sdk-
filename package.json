{
  "name": "steam-dlc-delivery",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side DLC content delivery for Steam games. ECDH P-256 key exchange. Unity C# SDK. MIT license.",
  "scripts": {
    "start": "cd local-test-server && npm start",
    "dev": "cd local-test-server && npm run dev",
    "test": "cd local-test-server && npm test",
    "test:e2e": "node tests/e2e-crypto-test.mjs",
    "test:all": "node tests/comprehensive-api-test.mjs",
    "test:ci": "DISABLE_RATE_LIMIT=true node tests/comprehensive-api-test.mjs",
    "test:prod": "bash scripts/test-production.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}